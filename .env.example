# Local development defaults. Copy to .env and fill in real values there -
# .env is gitignored; this file is NOT, so never put real secrets here.

# SAP Destination name pointing at the S/4HANA OData services (used only when
# S4_BASE_URL below is empty - i.e. the full BTP deployment path)
S4_DESTINATION_NAME=S4HANA_MATERIAL_API

# Direct-connect mode: set this to call the S/4 system directly, bypassing
# BTP Destination/Connectivity - useful for dev/testing against a directly
# reachable system before those services are provisioned.
S4_BASE_URL=https://<s4-host-or-ip>:44300
S4_USERNAME=
S4_PASSWORD=

# SAP logon client added as ?sap-client= to every S/4 call. Leave empty to use
# the BTP destination's own "sap-client" property (or the system default).
S4_SAP_CLIENT=100

# false only for a dev system with a self-signed HTTPS certificate.
S4_VERIFY_SSL=true

# Smart Material CDS views - OData V4 service (see SMC_OData_V4_URLs.xlsx).
# All Query/Report reads go to entity sets under this path.
S4_SMC_SERVICE_PATH=/sap/opu/odata4/sap/zsb_smc_material/srvd_a2x/sap/zsd_smc_material/0001

# Base URL this app is reachable at - used to build each A2A agent's AgentCard.url
# and report download links. Set to the real Cloud Foundry route once deployed.
APP_PUBLIC_URL=http://localhost:8000

# Base URL of the frontend app (frontend/manifest.yml) users open in the browser.
# Leave empty locally, where this app serves the page itself.
WEB_PUBLIC_URL=

REPORT_DOWNLOAD_TTL_SECONDS=900

# Material counts as "aged" when AgingDays is above this (Planner and Report agents).
AGED_THRESHOLD_DAYS=14

# SAP AI Core - direct Foundation Model access, used by the 3 agents to parse
# free-text input and phrase natural-language summaries. Leave AI_CORE_ENABLED
# false to keep the agents on structured-JSON-only input (current default
# behavior, no AI Core needed at all).
AI_CORE_ENABLED=false
AI_CORE_MODEL_NAME=gpt-4o-mini

# These are read directly by the gen_ai_hub SDK via os.environ (NOT through
# this app's own Settings/config.py) - come from your AI Core service key.
# On Cloud Foundry, bind an AI Core service instance instead and these are
# picked up automatically via VCAP_SERVICES - no need to set them here.
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default

# If set, identifies the exact AI Core deployment to call directly (preferred
# over AI_CORE_MODEL_NAME above - skips the model_name catalog lookup).
LLM_DEPLOYMENT_ID=

# Concurrency protection (per worker process). At most AGENT_MAX_CONCURRENCY
# LLM runs are in flight at once; extra requests wait up to
# AGENT_QUEUE_TIMEOUT_SECONDS, then get a "busy, try again" reply.
AGENT_MAX_CONCURRENCY=5
AGENT_QUEUE_TIMEOUT_SECONDS=60

# Logs raw A2A request/response bodies - debugging only, keep false.
A2A_WIRE_DEBUG=false

# IAS app-to-app authentication for the /a2a/* agent endpoints (app/core/ias_auth.py).
# false = no token needed (today's behaviour). true = every A2A call needs a valid IAS token
# (Joule via an OAuth2ClientCredentials destination, or Postman with a client-credentials token).
IAS_AUTH_ENABLED=false
IAS_ISSUER=https://<tenant>.accounts.ondemand.com
IAS_AUDIENCE=<client ID of the IAS application>
# Permission the token must carry; 'none' skips this check (an empty value can't be set on CF).
IAS_REQUIRED_API=api_read_access

# Sign-in for the web page's chat (app/core/web_login.py) - users log in with IAS, no token in
# the browser. Needs IAS_AUTH_ENABLED=true; the IAS application must list
# <WEB_PUBLIC_URL>/auth/callback as a redirect URI (APP_PUBLIC_URL when that is empty). Leave the secret empty to keep it off.
WEB_LOGIN_CLIENT_ID=
WEB_LOGIN_CLIENT_SECRET=
# Random, at least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SESSION_SECRET=
